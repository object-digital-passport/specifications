# Non-secret deployment inputs. Run from chain/ after release review and signer setup.
# This file alone cannot deploy; private signer configuration stays outside version control.
ODP_ENABLE_DEPLOY=0
ODP_DEPLOY_CHAIN_ID=137
ODP_GENERATION_ID=odp-0.7-redesign-8-polygon-20260924
ODP_RELEASE_BUNDLE=../review/v07-abi8-release/release.json
# ABI8 release hash approved by the owner on 2026-09-24.
ODP_RELEASE_HASH=sha256:7392c8214e7f1258e3dc886ce89f5b5df30f65bca6d0ace2d1b7b3006ca414d7
ODP_DEPLOY_MANIFEST=deploy/output/odp-0.7-redesign-8-polygon-20260924.json
