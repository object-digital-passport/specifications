ODP_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ODP_VERIFY_RPC_URL=https://polygon.drpc.org
# Chain137 additionally requires finalized receipt blocks and exact evidence from BOTH RPCs.
# Public address must match the configured signer. Do not paste private keys here.
ODP_DEPLOYER_ADDRESS=FILL_PUBLIC_ADDRESS
# Copy the example, fill decimal wei values after reading current RPC fees and balance.
ODP_SPEND_POLICY=deploy/mainnet-spend-policy.local.json
